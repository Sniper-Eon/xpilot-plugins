{
  "id": "phone_vision",
  "name": "Phone side-vehicle vision",
  "version": "1.0.1",
  "api": 1,
  "category": "data_source",
  "entry": "plugin:PhoneVision",
  "author": "Sniper-Eon",
  "description": "Opt-in single wide-camera transport to the existing TesNav phone model. 640 pixels, maximum 4 Hz; no camera process while disabled. Dual experiments are not enabled.",
  "priority": 100,
  "enable_param": "ExtPhoneVisionEnabled",
  "claims": [
    "process:phone_visiond"
  ],
  "settings": [
    {
      "key": "ExtPhoneVisionWidth",
      "label": "Image width",
      "choices": [
        [
          "320",
          320
        ],
        [
          "640",
          640
        ]
      ]
    }
  ],
  "params": {
    "ExtPhoneVisionEnabled": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtPhoneVisionWidth": {
      "type": "INT",
      "default": "640"
    },
    "ExtPhoneVisionToken": {
      "type": "STRING",
      "note": "Private connection code. Do not publish."
    }
  }
}
